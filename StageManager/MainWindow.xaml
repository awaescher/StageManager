<Window
    x:Class="StageManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:StageManager"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    Title="MainWindow"
    Height="450"
    Width="280"
    ShowActivated="False"
    Background="Transparent"
    Name="thisWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility" />
        <Style
            x:Key="CloseButton"
            TargetType="Button">
            <Setter
                Property="Width"
                Value="22" />
            <Setter
                Property="Height"
                Value="22" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="Visibility"
                Value="Collapsed" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Button">
                        <Grid
                            Background="Transparent">
                            <Ellipse
                                x:Name="disc"
                                Fill="#99000000" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="9"
                                Foreground="White"
                                Text="&#xE711;" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="disc"
                                    Property="Fill"
                                    Value="#E0C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SceneOpacity"
            TargetType="{x:Type StackPanel}">
            <Setter
                Property="Opacity"
                Value="0.8" />
            <Style.Triggers>
                <Trigger
                    Property="IsMouseOver"
                    Value="true">
                    <Setter
                        Property="Opacity"
                        Value="1" />
                </Trigger>
                <Trigger
                    Property="IsMouseOver"
                    Value="false">
                    <Setter
                        Property="Opacity"
                        Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel
        VerticalAlignment="Center">
        <ItemsControl
            Name="scenesControl"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Padding="12, 0, 0, 0"
            ItemsSource="{Binding Scenes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"
                        Visibility="{Binding Visibility}"
                        Style="{StaticResource SceneOpacity}"
                        Background="Transparent"
                        MouseLeftButtonDown="Card_MouseLeftButtonDown"
                        MouseMove="Card_MouseMove"
                        MouseLeftButtonUp="Card_MouseLeftButtonUp"
                        LostMouseCapture="Card_LostMouseCapture">
                        <StackPanel.ContextMenu>
                            <ContextMenu
                                Opened="CardMenu_Opened"
                                Closed="CardMenu_Closed">
                                <MenuItem
                                    Tag="add"
                                    Header="{local:Loc Card.AddToStage}"
                                    Click="CardMenu_Click" />
                                <MenuItem
                                    Tag="split"
                                    Header="{local:Loc Card.Separate}" />
                                <MenuItem
                                    Tag="exclude"
                                    Header="{local:Loc Card.Exclude}" />
                                <Separator />
                                <MenuItem
                                    Tag="close"
                                    Header="{local:Loc Card.Close}"
                                    Click="CardMenu_Click" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <!-- Windows: stacked thumbnails, the last window is in front. The highlight of a merge target reaches out
                             beyond them, DWM draws the thumbnails above it. -->
                        <Grid>
                        <Border
                            Margin="-7"
                            CornerRadius="12"
                            BorderThickness="3"
                            IsHitTestVisible="False">
                            <Border.Style>
                                <Style
                                    TargetType="Border">
                                    <Setter
                                        Property="Opacity"
                                        Value="0" />
                                    <Setter
                                        Property="BorderBrush">
                                        <Setter.Value>
                                            <SolidColorBrush
                                                Color="{x:Static SystemParameters.WindowGlassColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter
                                        Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush
                                                Opacity="0.25"
                                                Color="{x:Static SystemParameters.WindowGlassColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsHighlighted}"
                                            Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1"
                                                            Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0"
                                                            Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <ItemsControl
                            x:Name="thumbnailArea"
                            Width="{Binding ThumbnailWidth}"
                            Height="{Binding CardHeight}"
                            Opacity="{Binding CardOpacity}"
                            local:DwmThumbnail.ThumbnailOpacity="{Binding CardOpacity}"
                            ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid
                                        Margin="0,0,0,0"></Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:DwmThumbnail
                                        PreviewHandle="{Binding Handle}"
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Margin="{Binding Margin}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding IsThumbnailVisible, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                        <!-- Icons and the close button. The button sits here and not on the thumbnails, because DWM draws thumbnails above all WPF content. -->
                        <Grid
                            Margin="{Binding IconsMargin}"
                            Opacity="{Binding CardOpacity}"
                            Width="{Binding ThumbnailWidth}">
                            <ItemsControl
                                VerticalAlignment="Center"
                                HorizontalAlignment="{Binding IconAlignment, ElementName=thisWindow}"
                                ItemsSource="{Binding Windows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="8"
                                                    ShadowDepth="1"
                                                    Opacity="0.45" />
                                            </Border.Effect>
                                            <Image
                                                Margin="0, 0, 3, 0"
                                                Height="28"
                                                Source="{Binding Icon}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Style="{StaticResource CloseButton}"
                                HorizontalAlignment="{Binding CloseButtonAlignment, ElementName=thisWindow}"
                                VerticalAlignment="Center"
                                ToolTip="{local:Loc Card.Close}"
                                Click="CloseScene_Click" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <tb:TaskbarIcon
            x:Name="trayIcon"
            Visibility="Visible"
            ToolTipText="Stage Manager"
            IconSource="StageManager.ico"
            MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu
                    Opened="ContextMenu_Opened"
                    Closed="ContextMenu_Closed">
                    <MenuItem
                        Header="{local:Loc Tray.Settings}"
                        Click="MenuItem_Settings_Click" />
                    <Separator />
                    <MenuItem
                        Header="{local:Loc Tray.StartWithWindows}"
                        IsCheckable="True"
                        IsChecked="{Binding StartsWithWindows}" />
                    <MenuItem
                        Header="{local:Loc Tray.SidebarPosition}">
                        <MenuItem
                            x:Name="menuSideLeft"
                            Header="{local:Loc Common.Left}"
                            Click="MenuItem_SideLeft_Click" />
                        <MenuItem
                            x:Name="menuSideRight"
                            Header="{local:Loc Common.Right}"
                            Click="MenuItem_SideRight_Click" />
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSceneCount"
                        Header="{local:Loc Tray.ScenesInSidebar}" />
                    <MenuItem
                        Header="{local:Loc Tray.DesktopIcons}">
                        <MenuItem
                            x:Name="menuIconsManage"
                            Header="{local:Loc Tray.IconsAutomatic}"
                            Tag="Manage"
                            Click="MenuItem_Icons_Click" />
                        <MenuItem
                            x:Name="menuIconsHidden"
                            Header="{local:Loc Tray.IconsHidden}"
                            Tag="AlwaysHidden"
                            Click="MenuItem_Icons_Click" />
                        <MenuItem
                            x:Name="menuIconsUntouched"
                            Header="{local:Loc Tray.IconsUntouched}"
                            Tag="Untouched"
                            Click="MenuItem_Icons_Click" />
                    </MenuItem>
                    <MenuItem
                        Header="{local:Loc Tray.Rescue}"
                        Click="MenuItem_Rescue_Click" />
                    <MenuItem
                        Header="{local:Loc Tray.ProjectPage}"
                        Click="MenuItem_ProjectPage_Click" />
                    <Separator />
                    <MenuItem
                        Header="{local:Loc Tray.Quit}"
                        Click="MenuItem_Quit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </StackPanel>
</Window>
