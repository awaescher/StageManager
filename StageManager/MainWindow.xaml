<Window
    x:Class="StageManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:StageManager"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None"
    Title="MainWindow"
    Height="450"
    Width="280"
    ShowActivated="False"
    Background="Transparent"
    Name="thisWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility" />
        <Style
            x:Key="CloseButton"
            TargetType="Button">
            <Setter
                Property="Width"
                Value="22" />
            <Setter
                Property="Height"
                Value="22" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="Visibility"
                Value="Collapsed" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Button">
                        <Grid
                            Background="Transparent">
                            <Ellipse
                                x:Name="disc"
                                Fill="#99000000" />
                            <Path
                                Data="M 7,7 L 15,15 M 15,7 L 7,15"
                                Stroke="White"
                                StrokeThickness="1.6"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="disc"
                                    Property="Fill"
                                    Value="#E0C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SceneOpacity"
            TargetType="{x:Type StackPanel}">
            <Setter
                Property="Opacity"
                Value="0.8" />
            <Style.Triggers>
                <Trigger
                    Property="IsMouseOver"
                    Value="true">
                    <Setter
                        Property="Opacity"
                        Value="1" />
                </Trigger>
                <Trigger
                    Property="IsMouseOver"
                    Value="false">
                    <Setter
                        Property="Opacity"
                        Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel
        VerticalAlignment="Center">
        <ItemsControl
            Name="scenesControl"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Padding="12, 0, 0, 0"
            ItemsSource="{Binding Scenes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"
                        Visibility="{Binding Visibility}"
                        Style="{StaticResource SceneOpacity}">
                        <StackPanel.ContextMenu>
                            <ContextMenu
                                Opened="CardMenu_Opened"
                                Closed="CardMenu_Closed">
                                <MenuItem
                                    Tag="add"
                                    Header="Add to stage"
                                    Click="CardMenu_Click" />
                                <MenuItem
                                    Tag="split"
                                    Header="Separate from group" />
                                <Separator />
                                <MenuItem
                                    Tag="close"
                                    Header="Close"
                                    Click="CardMenu_Click" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <i:Interaction.Triggers>
                            <i:EventTrigger
                                EventName="MouseLeftButtonUp">
                                <i:InvokeCommandAction
                                    Command="{Binding SwitchSceneCommand, Mode=OneTime, Source={x:Reference thisWindow}}"
                                    CommandParameter="{Binding .}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <!-- Windows: stacked thumbnails, the last window is in front -->
                        <ItemsControl
                            Width="{Binding ThumbnailWidth}"
                            Height="{Binding ThumbnailHeight}"
                            ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid
                                        Margin="0,0,0,0"></Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:DwmThumbnail
                                        PreviewHandle="{Binding Handle}"
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Margin="{Binding Margin}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding IsThumbnailVisible, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Icons and the close button. The button sits here and not on the thumbnails, because DWM draws thumbnails above all WPF content. -->
                        <Grid
                            Margin="0,4,0,24"
                            Width="{Binding ThumbnailWidth}">
                            <ItemsControl
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                ItemsSource="{Binding Windows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20" />
                                            </Border.Effect>
                                            <Image
                                                Margin="0, 0, 0, 0"
                                                Height="30"
                                                Source="{Binding Icon}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Style="{StaticResource CloseButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTip="Close"
                                Click="CloseScene_Click" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <tb:TaskbarIcon
            x:Name="trayIcon"
            Visibility="Visible"
            ToolTipText="Stage Manager"
            IconSource="StageManager.ico"
            MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu
                    Opened="ContextMenu_Opened"
                    Closed="ContextMenu_Closed">
                    <MenuItem
                        Header="Settings..."
                        Click="MenuItem_Settings_Click" />
                    <Separator />
                    <MenuItem
                        Header="Start with Windows"
                        IsCheckable="True"
                        IsChecked="{Binding StartsWithWindows}" />
                    <MenuItem
                        Header="Sidebar position">
                        <MenuItem
                            x:Name="menuSideLeft"
                            Header="Left"
                            Click="MenuItem_SideLeft_Click" />
                        <MenuItem
                            x:Name="menuSideRight"
                            Header="Right"
                            Click="MenuItem_SideRight_Click" />
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSceneCount"
                        Header="Scenes in sidebar" />
                    <MenuItem
                        Header="Desktop icons">
                        <MenuItem
                            x:Name="menuIconsManage"
                            Header="Automatic (hide while a scene is active)"
                            Tag="Manage"
                            Click="MenuItem_Icons_Click" />
                        <MenuItem
                            x:Name="menuIconsHidden"
                            Header="Always hidden"
                            Tag="AlwaysHidden"
                            Click="MenuItem_Icons_Click" />
                        <MenuItem
                            x:Name="menuIconsUntouched"
                            Header="Never change"
                            Tag="Untouched"
                            Click="MenuItem_Icons_Click" />
                    </MenuItem>
                    <MenuItem
                        Header="Project page"
                        Click="MenuItem_ProjectPage_Click" />
                    <Separator />
                    <MenuItem
                        Header="Quit"
                        Click="MenuItem_Quit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </StackPanel>
</Window>
