<Window
    x:Class="StageManager.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="StageManager settings"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True">
    <Window.Resources>
        <Style
            x:Key="Heading"
            TargetType="TextBlock">
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="Margin"
                Value="0,16,0,6" />
        </Style>
        <Style
            x:Key="Label"
            TargetType="TextBlock">
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="Margin"
                Value="0,0,12,0" />
        </Style>
        <Style
            x:Key="Hint"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="Gray" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Margin"
                Value="0,4,0,0" />
        </Style>
        <Style
            TargetType="ComboBox">
            <Setter
                Property="Margin"
                Value="0,3" />
            <Setter
                Property="Padding"
                Value="6,3" />
        </Style>
        <Style
            TargetType="CheckBox">
            <Setter
                Property="Margin"
                Value="0,4" />
        </Style>
    </Window.Resources>
    <StackPanel
        Margin="20,4,20,16">

        <TextBlock
            Style="{StaticResource Heading}"
            Text="General" />
        <CheckBox
            x:Name="autostart"
            Content="Start with Windows"
            Click="Autostart_Click" />
        <Grid
            Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="170" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource Label}"
                Text="Hide other windows by" />
            <ComboBox
                x:Name="hideStrategy"
                Grid.Column="1"
                SelectionChanged="HideStrategy_SelectionChanged" />
        </Grid>
        <TextBlock
            Style="{StaticResource Hint}"
            Text="Moving a window out of the screen keeps its picture in the sidebar. Minimized windows of browsers and WebView apps lose theirs." />

        <TextBlock
            Style="{StaticResource Heading}"
            Text="Sidebar" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="170" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock
                Style="{StaticResource Label}"
                Text="Position" />
            <ComboBox
                x:Name="side"
                Grid.Column="1"
                SelectionChanged="Side_SelectionChanged" />

            <TextBlock
                Grid.Row="1"
                Style="{StaticResource Label}"
                Text="Scenes in sidebar" />
            <ComboBox
                x:Name="sceneCount"
                Grid.Row="1"
                Grid.Column="1"
                SelectionChanged="SceneCount_SelectionChanged" />

            <TextBlock
                Grid.Row="2"
                Style="{StaticResource Label}"
                Text="Windows per scene" />
            <ComboBox
                x:Name="windowsPerScene"
                Grid.Row="2"
                Grid.Column="1"
                SelectionChanged="WindowsPerScene_SelectionChanged" />

            <TextBlock
                Grid.Row="3"
                Style="{StaticResource Label}"
                Text="Thumbnail size" />
            <ComboBox
                x:Name="thumbnailSize"
                Grid.Row="3"
                Grid.Column="1"
                SelectionChanged="ThumbnailSize_SelectionChanged" />

            <TextBlock
                Grid.Row="4"
                Style="{StaticResource Label}"
                Text="Sidebar width" />
            <ComboBox
                x:Name="sidebarWidth"
                Grid.Row="4"
                Grid.Column="1"
                SelectionChanged="SidebarWidth_SelectionChanged" />
        </Grid>
        <TextBlock
            x:Name="layoutInfo"
            Style="{StaticResource Hint}" />
        <TextBlock
            x:Name="layoutWarning"
            Style="{StaticResource Hint}"
            Foreground="DarkOrange"
            Visibility="Collapsed" />
        <CheckBox
            x:Name="dragToStage"
            Margin="0,8,0,4"
            Click="DragToStage_Click">
            <TextBlock
                TextWrapping="Wrap"
                Text="Drag a card onto the stage to add its apps to it" />
        </CheckBox>

        <TextBlock
            Style="{StaticResource Heading}"
            Text="Animations" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="170" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Style="{StaticResource Label}"
                Text="Animate scene changes" />
            <ComboBox
                x:Name="animationMode"
                Grid.Column="1"
                SelectionChanged="AnimationMode_SelectionChanged" />
            <TextBlock
                Grid.Row="1"
                Style="{StaticResource Label}"
                Text="Speed" />
            <ComboBox
                x:Name="animationSpeed"
                Grid.Row="1"
                Grid.Column="1"
                SelectionChanged="AnimationSpeed_SelectionChanged" />
        </Grid>
        <CheckBox
            x:Name="animationFrames"
            Click="AnimationFrames_Click">
            <TextBlock
                TextWrapping="Wrap"
                Text="Fly a frame instead of the windows if Windows shows only a frame while dragging" />
        </CheckBox>
        <TextBlock
            x:Name="animationInfo"
            Style="{StaticResource Hint}" />

        <TextBlock
            Style="{StaticResource Heading}"
            Text="Desktop icons" />
        <ComboBox
            x:Name="iconsMode"
            SelectionChanged="IconsMode_SelectionChanged" />
        <CheckBox
            x:Name="iconsRestore"
            Click="IconsRestore_Click">
            <TextBlock
                TextWrapping="Wrap"
                Text="Restore the icons to their previous state when StageManager exits" />
        </CheckBox>

        <Grid
            Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource Hint}"
                VerticalAlignment="Center"
                Text="Changes apply immediately." />
            <Button
                Grid.Column="1"
                Padding="14,5"
                Content="Reset to defaults"
                Click="Reset_Click" />
        </Grid>
    </StackPanel>
</Window>
